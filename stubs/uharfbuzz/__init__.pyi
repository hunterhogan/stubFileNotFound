from collections.abc import Iterator

class Blob:
	@staticmethod
	def from_file_path(filename: str) -> Blob: ...

class Set:
	def __iter__(self) -> Iterator[int]: ...
	def __len__(self) -> int: ...
	def __contains__(self, value: object) -> bool: ...

class Face:
	def __init__(self, blob: Blob, index: int = 0) -> None: ...
	@property
	def unicodes(self) -> Set: ...

class GlyphInfo:
	@property
	def codepoint(self) -> int: ...
	@property
	def cluster(self) -> int: ...

class GlyphPosition:
	@property
	def position(self) -> tuple[int, int, int, int]: ...

class Font:
	def __init__(self, face: Face) -> None: ...
	def glyph_to_string(self, gid: int) -> str: ...

class Buffer:
	def __init__(self) -> None: ...
	def add_str(self, text: str, item_offset: int = 0, item_length: int = -1) -> None: ...
	def guess_segment_properties(self) -> None: ...
	@property
	def glyph_infos(self) -> list[GlyphInfo]: ...
	@property
	def glyph_positions(self) -> list[GlyphPosition]: ...

def shape(font: Font, buffer: Buffer, features: dict[str, object] | None = None, shapers: list[str] | None = None) -> None: ...
